# ---------------------------------------------------------------------------
# Q Crackers — environment variables
# Copy to .env (local), and configure separately for staging & production.
# NEVER commit a real .env file. Secrets live in the hosting platform's
# secret manager (Vercel / Supabase), not in the repo.
# ---------------------------------------------------------------------------

# Node environment: development | staging | production | test
NODE_ENV=development

# Opt out of Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1

# Public base URL of the app (used for absolute links / cookies).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) -------------------------------------------------
# Local dev via docker-compose:
DATABASE_URL=postgresql://qcrackers:qcrackers@localhost:5432/qcrackers?schema=public
# When DATABASE_URL points at a connection pooler (Supabase PgBouncer),
# set DIRECT_URL to the direct 5432 connection for migrations.
DIRECT_URL=postgresql://qcrackers:qcrackers@localhost:5432/qcrackers?schema=public

# --- Auth / sessions -----------------------------------------------------
# Idle timeout and absolute cap for a login session.
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_HOURS=168
# Lockout policy for failed logins.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Seed (initial internal accounts) ----------------------------------
# Optional. If a password is not supplied, the seed generates a strong
# random one and prints it ONCE. All seeded users must change password on
# first login.
SEED_PARTNER1_EMAIL=partner1@qcrackers.local
SEED_PARTNER2_EMAIL=partner2@qcrackers.local
SEED_PARTNER3_EMAIL=partner3@qcrackers.local
SEED_STAFF1_EMAIL=staff1@qcrackers.local
SEED_STAFF2_EMAIL=staff2@qcrackers.local
# SEED_PARTNER1_PASSWORD=
# SEED_PARTNER2_PASSWORD=
# SEED_PARTNER3_PASSWORD=
# SEED_STAFF1_PASSWORD=
# SEED_STAFF2_PASSWORD=

# Optional: also create a small demo catalogue (categories + products + stock).
# SEED_SAMPLE_CATALOGUE=1

# --- Object storage (product images; LR / parcel PDFs) ---------------
# "filesystem" (dev) keeps files under STORAGE_FS_DIR, served only via the
# app's authorised media route. "supabase" uses a PRIVATE bucket.
STORAGE_DRIVER=filesystem
STORAGE_FS_DIR=.storage
STORAGE_MAX_IMAGE_BYTES=5242880
# Upload cap for LR / parcel-booking PDFs (Booking panel). Default 10 MB.
STORAGE_MAX_DOCUMENT_BYTES=10485760
# Required only when STORAGE_DRIVER=supabase:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY — never expose to the browser
SUPABASE_STORAGE_BUCKET=qc-media

# --- Scheduled jobs ---------------------------------------------------
# Bearer secret for /api/cron/* routes (expired stock-hold release,
# notification delivery). Min 16 chars. When unset, the cron routes return 503.
# Call each route with header:  Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# --- Customer tracking links ----------------------------------------
# HMAC key the tracking token is derived from (32+ chars). Recommended in
# staging/production so links survive a DATABASE_URL change and can be rotated
# deliberately. When unset, a stable value is derived from DATABASE_URL.
# SERVER ONLY — never expose to the browser.
# TRACKING_LINK_SECRET=

# --- Payments --------------------------------------------------------
# Phase 5 uses UPI + manual/PSP verification — there is NO Razorpay.
# Per-partner UPI collection details (VPA, payee name, QR) are configured
# in the console (Payment account), not via environment variables.

# --- WhatsApp notifications (Phase 8) -------------------------------
# "none" (default) = messages are recorded in the outbox but not sent; the app
#   works normally. "log" = write messages to the server log (local dev).
#   "meta" = the real WhatsApp Business Cloud API.
WHATSAPP_PROVIDER=none
# Required only when WHATSAPP_PROVIDER=meta. SERVER ONLY — never NEXT_PUBLIC.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_MAX_ATTEMPTS=5

# --- Cashfree automatic UPI verification (Phase 10) --------------------
# A partner opts in from the console (Payment account -> pspProvider) once
# they've onboarded with Cashfree; until then they keep the static-QR /
# manual-verify flow above. SANDBOX default — flip to PRODUCTION only after a
# partner's sandbox flow has been tested end to end.
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01
# One App ID + Secret Key PER PARTNER (their own Cashfree account), named by
# login code. SERVER ONLY — never NEXT_PUBLIC, never logged, never in the DB.
# CASHFREE_APP_ID_PK=
# CASHFREE_SECRET_KEY_PK=

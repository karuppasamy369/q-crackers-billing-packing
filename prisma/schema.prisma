// Q Crackers — Prisma schema
// Phase 0 / Phase 1 scope: identity, RBAC, sessions, audit.
// Later phases (products, orders, payments, billing, booking, tracking,
// notifications) will extend this file.
//
// Portability: provider is plain "postgresql". No Supabase-specific features
// are used, so this runs on Supabase, RDS, Neon, or a self-hosted Postgres.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL is used for migrations when DATABASE_URL points at a pooler
  // (e.g. Supabase PgBouncer). Falls back to DATABASE_URL if unset.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleKey {
  PARTNER
  STAFF
}

/// Direction of a per-user permission override.
/// DENY always wins over ALLOW and over the role default.
enum PermissionEffect {
  ALLOW
  DENY
}

/// Why an inventory quantity changed. Phase 2 uses RESTOCK and ADJUSTMENT;
/// the order-driven reasons are wired up in later phases.
enum InventoryMovementReason {
  RESTOCK
  ADJUSTMENT
  RESERVE
  RELEASE
  SALE
  RETURN
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         RoleKey  @unique
  name        String
  description String
  /// System roles cannot be deleted or renamed via the app.
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable machine key, e.g. "booking.pack". Never reuse a retired key.
  key         String   @unique
  category    String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles         RolePermission[]
  userOverrides UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Per-user grant or revoke on top of the role default.
model UserPermission {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  permissionId String           @db.Uuid
  effect       PermissionEffect
  /// Free-text reason captured for the audit trail.
  note         String?
  createdById  String?          @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User       @relation("UserPermissionTarget", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("UserPermissionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

// ---------------------------------------------------------------------------
// Users & sessions
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Immutable login code that drives bill numbering: P1, P2, P3, S1, S2, ...
  code                String    @unique
  name                String
  /// Stored lower-cased; unique.
  email               String    @unique
  /// Argon2id hash. Never logged, never returned to the client.
  passwordHash        String
  roleId              String    @db.Uuid
  isActive            Boolean   @default(true)
  /// Forces a password change on next login (first login, or after a reset).
  mustChangePassword  Boolean   @default(true)
  /// Reserved for future TOTP 2FA (partners). Nullable = not enrolled.
  totpSecret          String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  role                Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions            Session[]
  permissionOverrides UserPermission[]    @relation("UserPermissionTarget")
  authoredOverrides   UserPermission[]    @relation("UserPermissionAuthor")
  auditLogs           AuditLog[]          @relation("AuditActor")
  revokedSessions     Session[]           @relation("SessionRevoker")
  settingsEdited      Setting[]           @relation("SettingEditor")
  inventoryMovements  InventoryMovement[] @relation("InventoryMovementAuthor")

  @@index([roleId])
  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  /// SHA-256 hex of the opaque session token. The raw token only ever lives
  /// in the client cookie — it is never stored.
  tokenHash         String    @unique
  /// Absolute expiry. Idle renewal extends this up to the absolute cap.
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  ip                String?
  userAgent         String?
  revokedAt         DateTime?
  revokedById       String?   @db.Uuid

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("SessionRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Audit log — append only (enforced by a DB trigger, see migration)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Monotonic ordering key, independent of clock skew.
  seq         BigInt   @default(autoincrement())
  /// Null actor = system-generated action.
  actorUserId String?  @db.Uuid
  actorCode   String?
  actorRole   String?
  /// Machine key, e.g. "auth.login", "user.password_reset".
  action      String
  entityType  String?
  entityId    String?
  summary     String
  details     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([seq])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Business settings — a typed key/value store. Keys, schemas, defaults and
// public visibility live in src/lib/settings/registry.ts.
// ---------------------------------------------------------------------------

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  updatedBy User? @relation("SettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Catalogue: categories, products, images
// ---------------------------------------------------------------------------

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  /// URL-safe unique identifier used in storefront links.
  slug            String   @unique
  description     String?
  /// Private storage key for the category banner image (nullable).
  imageStorageKey String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  /// Internal stock-keeping unit — unique, case-insensitive by convention.
  sku         String  @unique
  name        String
  slug        String  @unique
  categoryId  String  @db.Uuid
  description String?

  /// All money is integer paise. price is what the customer pays;
  /// mrp is the optional "list price" shown struck-through.
  pricePaise Int
  mrpPaise   Int?

  /// GST is not hard-coded: rate is stored per product in basis points
  /// (1800 = 18.00%). HSN code for the tax invoice. Whether the stored
  /// price is inclusive of GST is a business setting, not a product field.
  hsnCode   String?
  gstRateBp Int     @default(0)

  /// Shipping inputs kept ready for weight-based rules (Phase 3+).
  weightGrams Int?

  /// isActive = sellable at all (internal + online).
  /// isVisibleOnline = shown in the public storefront (implies isActive).
  isActive        Boolean @default(true)
  isVisibleOnline Boolean @default(false)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images    ProductImage[]
  inventory Inventory?
  movements InventoryMovement[]

  @@index([categoryId])
  @@index([isVisibleOnline, isActive])
  @@index([isActive, sortOrder])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  /// Random, unguessable key inside a PRIVATE storage bucket.
  storageKey  String   @unique
  altText     String?
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  // At most one primary image per product (enforced by a partial unique index
  // added in the migration).
  @@map("product_images")
}

model Inventory {
  productId        String   @id @db.Uuid
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  reorderLevel     Int      @default(0)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model InventoryMovement {
  id           String                  @id @default(uuid()) @db.Uuid
  productId    String                  @db.Uuid
  /// Signed delta applied to quantityOnHand (e.g. +50 restock, -3 correction).
  changeQty    Int
  /// quantityOnHand immediately after this movement — a running ledger.
  balanceAfter Int
  reason       InventoryMovementReason
  note         String?
  /// Optional link to whatever caused the movement (e.g. an order later).
  refType      String?
  refId        String?
  createdById  String?                 @db.Uuid
  createdAt    DateTime                @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("InventoryMovementAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

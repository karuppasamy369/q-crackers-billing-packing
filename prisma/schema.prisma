// Q Crackers — Prisma schema
// Phase 0 / Phase 1 scope: identity, RBAC, sessions, audit.
// Later phases (products, orders, payments, billing, booking, tracking,
// notifications) will extend this file.
//
// Portability: provider is plain "postgresql". No Supabase-specific features
// are used, so this runs on Supabase, RDS, Neon, or a self-hosted Postgres.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL is used for migrations when DATABASE_URL points at a pooler
  // (e.g. Supabase PgBouncer). Falls back to DATABASE_URL if unset.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleKey {
  PARTNER
  STAFF
}

/// Direction of a per-user permission override.
/// DENY always wins over ALLOW and over the role default.
enum PermissionEffect {
  ALLOW
  DENY
}

/// Why an inventory quantity changed. Phase 2 uses RESTOCK and ADJUSTMENT;
/// Phase 3 adds RESERVE at checkout; SALE/RELEASE follow payment in Phase 5.
enum InventoryMovementReason {
  RESTOCK
  ADJUSTMENT
  RESERVE
  RELEASE
  SALE
  RETURN
}

/// Order lifecycle. Phase 3 only creates orders in AWAITING_PAYMENT; the full
/// state machine (guards, transitions) is built in Phases 5–6.
enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_FAILED
  PAID
  PACKED
  PARCEL_BOOKED
  COMPLETED
  CANCELLED
  REFUNDED
}

/// Payment state, tracked separately from the order's fulfilment state.
enum OrderPaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderSource {
  ONLINE
  INTERNAL
}

/// How a bill was raised. ONLINE_ORDER bills are generated for a paid online
/// order (under the house partner code); COUNTER bills are walk-in sales
/// created directly by a partner or staff member (under their own code).
enum BillType {
  ONLINE_ORDER
  COUNTER
}

enum BillStatus {
  ISSUED
  CANCELLED
}

/// Payment mode recorded on a counter bill.
enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

/// Online-order payment lifecycle. INITIATED = record created; SUBMITTED =
/// customer supplied a UTR; VERIFIED = an authorised person (or, later, a PSP /
/// webhook) confirmed it; REJECTED = confirmed not received; FAILED = the hold
/// expired before verification.
enum PaymentStatus {
  INITIATED
  SUBMITTED
  VERIFIED
  REJECTED
  FAILED
}

enum PaymentChannel {
  UPI
  BANK_TRANSFER
  CASH
  OTHER
}

/// How a payment was confirmed. Phase 5 ships MANUAL only; PSP_API and WEBHOOK
/// are wired in later behind the PaymentVerifier interface.
enum PaymentVerificationMethod {
  MANUAL
  PSP_API
  WEBHOOK
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         RoleKey  @unique
  name        String
  description String
  /// System roles cannot be deleted or renamed via the app.
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable machine key, e.g. "booking.pack". Never reuse a retired key.
  key         String   @unique
  category    String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles         RolePermission[]
  userOverrides UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Per-user grant or revoke on top of the role default.
model UserPermission {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  permissionId String           @db.Uuid
  effect       PermissionEffect
  /// Free-text reason captured for the audit trail.
  note         String?
  createdById  String?          @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User       @relation("UserPermissionTarget", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("UserPermissionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

// ---------------------------------------------------------------------------
// Users & sessions
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Immutable login code that drives bill numbering: PK, PSR, KA, S1, S2, ...
  code                String    @unique
  name                String
  /// Stored lower-cased; unique.
  email               String    @unique
  /// Argon2id hash. Never logged, never returned to the client.
  passwordHash        String
  roleId              String    @db.Uuid
  isActive            Boolean   @default(true)
  /// Forces a password change on next login (first login, or after a reset).
  mustChangePassword  Boolean   @default(true)
  /// Reserved for future TOTP 2FA (partners). Nullable = not enrolled.
  totpSecret          String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  role                  Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions              Session[]
  permissionOverrides   UserPermission[]        @relation("UserPermissionTarget")
  authoredOverrides     UserPermission[]        @relation("UserPermissionAuthor")
  auditLogs             AuditLog[]              @relation("AuditActor")
  revokedSessions       Session[]               @relation("SessionRevoker")
  settingsEdited        Setting[]               @relation("SettingEditor")
  inventoryMovements    InventoryMovement[]     @relation("InventoryMovementAuthor")
  orderStatusChanges    OrderStatusHistory[]    @relation("OrderStatusChanger")
  billsCreated          Bill[]                  @relation("BillCreator")
  billsCancelled        Bill[]                  @relation("BillCanceller")
  ordersAssigned        Order[]                 @relation("OrderPartner")
  paymentsVerified      Payment[]               @relation("PaymentVerifier")
  paymentAccount        PartnerPaymentAccount?
  paymentAccountsEdited PartnerPaymentAccount[] @relation("PaymentAccountEditor")
  bookingsPacked        Booking[]               @relation("BookingPacker")
  bookingsParcelBooked  Booking[]               @relation("BookingParcelBooker")
  lrDocumentsUploaded   LrDocument[]            @relation("LrUploader")

  @@index([roleId])
  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  /// SHA-256 hex of the opaque session token. The raw token only ever lives
  /// in the client cookie — it is never stored.
  tokenHash         String    @unique
  /// Absolute expiry. Idle renewal extends this up to the absolute cap.
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  ip                String?
  userAgent         String?
  revokedAt         DateTime?
  revokedById       String?   @db.Uuid

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("SessionRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Audit log — append only (enforced by a DB trigger, see migration)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Monotonic ordering key, independent of clock skew.
  seq         BigInt   @default(autoincrement())
  /// Null actor = system-generated action.
  actorUserId String?  @db.Uuid
  actorCode   String?
  actorRole   String?
  /// Machine key, e.g. "auth.login", "user.password_reset".
  action      String
  entityType  String?
  entityId    String?
  summary     String
  details     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([seq])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Business settings — a typed key/value store. Keys, schemas, defaults and
// public visibility live in src/lib/settings/registry.ts.
// ---------------------------------------------------------------------------

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  updatedBy User? @relation("SettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Catalogue: categories, products, images
// ---------------------------------------------------------------------------

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  /// URL-safe unique identifier used in storefront links.
  slug            String   @unique
  description     String?
  /// Private storage key for the category banner image (nullable).
  imageStorageKey String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  /// Internal stock-keeping unit — unique, case-insensitive by convention.
  sku         String  @unique
  name        String
  slug        String  @unique
  categoryId  String  @db.Uuid
  description String?

  /// All money is integer paise. price is what the customer pays;
  /// mrp is the optional "list price" shown struck-through.
  pricePaise Int
  mrpPaise   Int?

  /// GST is not hard-coded: rate is stored per product in basis points
  /// (1800 = 18.00%). HSN code for the tax invoice. Whether the stored
  /// price is inclusive of GST is a business setting, not a product field.
  hsnCode   String?
  gstRateBp Int     @default(0)

  /// Shipping inputs kept ready for weight-based rules (Phase 3+).
  weightGrams Int?

  /// isActive = sellable at all (internal + online).
  /// isVisibleOnline = shown in the public storefront (implies isActive).
  isActive        Boolean @default(true)
  isVisibleOnline Boolean @default(false)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  inventory  Inventory?
  movements  InventoryMovement[]
  orderItems OrderItem[]
  billItems  BillItem[]

  @@index([categoryId])
  @@index([isVisibleOnline, isActive])
  @@index([isActive, sortOrder])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  /// Random, unguessable key inside a PRIVATE storage bucket.
  storageKey  String   @unique
  altText     String?
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  // At most one primary image per product (enforced by a partial unique index
  // added in the migration).
  @@map("product_images")
}

model Inventory {
  productId        String   @id @db.Uuid
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  reorderLevel     Int      @default(0)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model InventoryMovement {
  id           String                  @id @default(uuid()) @db.Uuid
  productId    String                  @db.Uuid
  /// Signed delta applied to quantityOnHand (e.g. +50 restock, -3 correction).
  changeQty    Int
  /// quantityOnHand immediately after this movement — a running ledger.
  balanceAfter Int
  reason       InventoryMovementReason
  note         String?
  /// Optional link to whatever caused the movement (e.g. an order later).
  refType      String?
  refId        String?
  createdById  String?                 @db.Uuid
  createdAt    DateTime                @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("InventoryMovementAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Customers & orders (Phase 3)
// ---------------------------------------------------------------------------

model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  /// As entered.
  phone           String
  /// Normalised E.164 (+91XXXXXXXXXX) for lookup / dedupe.
  phoneNormalized String
  email           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders Order[]
  bills  Bill[]

  @@index([phoneNormalized])
  @@map("customers")
}

model Order {
  id         String @id @default(uuid()) @db.Uuid
  /// Unguessable random token used in the customer-facing confirmation URL.
  /// (Phase 7 adds a separate tracking token for the tracking page.)
  reference  String @unique
  customerId String @db.Uuid

  status        OrderStatus        @default(AWAITING_PAYMENT)
  paymentStatus OrderPaymentStatus @default(PENDING)
  source        OrderSource        @default(ONLINE)

  /// The partner this order belongs to. Set once at checkout (direct orders →
  /// house partner; /s/<code> link orders → that partner) and NEVER changed —
  /// a DB trigger blocks re-assignment. Drives billing and reports.
  assignedPartnerId   String? @db.Uuid
  assignedPartnerCode String?

  // Customer + delivery snapshot (immutable once placed).
  customerName  String
  customerPhone String
  customerEmail String?
  addressLine1  String
  addressLine2  String?
  city          String
  stateCode     String
  stateName     String
  pincode       String

  // All money in integer paise.
  subtotalPaise Int
  discountPaise Int @default(0)
  taxPaise      Int
  shippingPaise Int
  totalPaise    Int

  /// Snapshot of tax.pricesIncludeGst at order time.
  pricesIncludeGst Boolean
  /// Snapshot of the shipping mode used.
  shippingMode     String

  /// Optimistic-lock version for later state transitions.
  version       Int       @default(0)
  /// Stock is reserved until this time; Phase 5 releases expired holds.
  holdExpiresAt DateTime?
  notes         String?
  placedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedPartner User?                @relation("OrderPartner", fields: [assignedPartnerId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  history         OrderStatusHistory[]
  payments        Payment[]
  bill            Bill?
  booking         Booking?

  @@index([customerId])
  @@index([assignedPartnerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  productId String @db.Uuid

  // Snapshots taken at order time.
  sku            String
  productName    String
  unitPricePaise Int
  gstRateBp      Int
  quantity       Int

  lineSubtotalPaise Int
  lineTaxPaise      Int
  lineTotalPaise    Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  /// Null actor = system / customer action.
  changedById String?      @db.Uuid
  reason      String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("OrderStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Billing (Phase 4)
// ---------------------------------------------------------------------------

/// One row per (userCode, fiscalYear). `lastNumber` is bumped atomically
/// inside the bill-issuing transaction via INSERT ... ON CONFLICT DO UPDATE.
model BillSequence {
  userCode   String
  fiscalYear Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@id([userCode, fiscalYear])
  @@map("bill_sequences")
}

model Bill {
  id String @id @default(uuid()) @db.Uuid

  /// Human bill number, e.g. "PK-2026-0001". Unique; never reused.
  billNumber String     @unique
  /// The login code the number was allocated under.
  userCode   String
  fiscalYear Int
  sequenceNo Int
  type       BillType
  status     BillStatus @default(ISSUED)

  /// Who created it (null once that user is deleted, or for system issuance).
  createdById String? @db.Uuid
  /// Set only for ONLINE_ORDER bills.
  orderId     String? @unique @db.Uuid
  customerId  String? @db.Uuid

  // --- Snapshots (immutable once issued) ---
  sellerName      String
  sellerGstin     String?
  sellerStateCode String
  sellerAddress   String?

  buyerName      String
  buyerPhone     String?
  buyerGstin     String?
  buyerAddress   String?
  buyerStateCode String
  buyerStateName String

  /// true = intra-state supply (CGST + SGST); false = inter-state (IGST).
  intraState  Boolean
  paymentMode PaymentMode?

  // All money integer paise.
  subtotalPaise     Int
  discountPaise     Int @default(0)
  taxableValuePaise Int
  cgstPaise         Int @default(0)
  sgstPaise         Int @default(0)
  igstPaise         Int @default(0)
  /// Delivery / freight charge carried from an online order. Not GST-split in V1.
  shippingPaise     Int @default(0)
  roundOffPaise     Int @default(0)
  totalPaise        Int

  pdfStorageKey String?

  cancelledReason String?
  cancelledAt     DateTime?
  cancelledById   String?   @db.Uuid

  billedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User?      @relation("BillCreator", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy User?      @relation("BillCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       BillItem[]

  @@index([userCode, fiscalYear, sequenceNo])
  @@index([status])
  @@index([billedAt])
  @@index([customerId])
  @@map("bills")
}

model BillItem {
  id     String @id @default(uuid()) @db.Uuid
  billId String @db.Uuid

  /// Nullable so a bill line survives product deletion; RESTRICT keeps it while
  /// the product exists.
  productId String? @db.Uuid

  sku            String
  name           String
  hsnCode        String?
  unitPricePaise Int
  gstRateBp      Int
  quantity       Int
  discountPaise  Int     @default(0)

  taxableValuePaise Int
  cgstPaise         Int @default(0)
  sgstPaise         Int @default(0)
  igstPaise         Int @default(0)
  lineTotalPaise    Int

  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@map("bill_items")
}

// ---------------------------------------------------------------------------
// Payments (Phase 5) — provider-agnostic UPI + manual verification
// ---------------------------------------------------------------------------

/// Per-partner payment collection details. One row per partner; each partner
/// edits only their own (permission `payments.account.manage`). The house
/// partner's row doubles as the house account.
model PartnerPaymentAccount {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @unique @db.Uuid
  /// UPI VPA / handle, e.g. "shop@okhdfcbank".
  upiVpa             String?
  payeeName          String?
  /// Optional uploaded static QR (private storage key) as a fallback to the
  /// generated amount-filled QR.
  staticQrStorageKey String?
  instructions       String?
  isActive           Boolean @default(true)

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("PaymentAccountEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("partner_payment_accounts")
}

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  channel  PaymentChannel @default(UPI)
  /// "MANUAL" now; a PSP name later. Free text so new providers need no enum bump.
  provider String         @default("MANUAL")
  status   PaymentStatus  @default(INITIATED)

  /// Amount expected — snapshot of order.totalPaise when the payment was created.
  amountPaise Int
  currency    String @default("INR")

  /// Customer-supplied UPI transaction id / UTR. Globally unique when present.
  upiReference String?
  payerName    String?
  payerVpa     String?

  /// Snapshot of the collecting partner's account at submission time.
  payeeVpa          String?
  payeeName         String?
  assignedPartnerId String? @db.Uuid

  submittedAt        DateTime?
  verifiedById       String?                    @db.Uuid
  verifiedAt         DateTime?
  verificationMethod PaymentVerificationMethod?
  rejectionReason    String?

  /// Raw payload from a future PSP / webhook verification.
  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([assignedPartnerId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Booking (Phase 6) — packing, courier / LR entry, LR document
// ---------------------------------------------------------------------------

/// One booking record per order. Created when the order is first marked PACKED;
/// the courier / LR fields are filled in and frozen when the order transitions
/// to PARCEL_BOOKED. A DB CHECK enforces that PARCEL_BOOKED requires the four
/// mandatory fields.
model Booking {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid

  /// Courier / transport company name.
  courierName String?
  /// LR / parcel / consignment number from the courier.
  lrNumber    String?
  /// Date the parcel was handed to the courier.
  bookingDate DateTime? @db.Date
  /// Number of parcels / packages in the consignment.
  parcelCount Int?
  remarks     String?

  packedAt         DateTime?
  packedById       String?   @db.Uuid
  parcelBookedAt   DateTime?
  parcelBookedById String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packedBy       User?        @relation("BookingPacker", fields: [packedById], references: [id], onDelete: SetNull)
  parcelBookedBy User?        @relation("BookingParcelBooker", fields: [parcelBookedById], references: [id], onDelete: SetNull)
  lrDocuments    LrDocument[]

  @@map("bookings")
}

/// An uploaded LR / parcel-booking PDF. Re-uploading keeps the history: the
/// previous row is marked `isCurrent = false` with `supersededAt` set. A
/// partial unique index guarantees at most one current document per order.
model LrDocument {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid
  orderId   String @db.Uuid

  /// Private-bucket storage key. Never served directly — only through an
  /// authorised route (console `lr.download`, or the customer's tracking link).
  storageKey       String
  originalFilename String
  byteSize         Int
  isCurrent        Boolean @default(true)

  uploadedById String?   @db.Uuid
  uploadedAt   DateTime  @default(now())
  supersededAt DateTime?

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("LrUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([orderId])
  @@map("lr_documents")
}
